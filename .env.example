# Frontend environment variables (Next.js).
#
# Every variable in this file is prefixed NEXT_PUBLIC_ — Next.js inlines
# those into the browser bundle at build time, so by definition NONE of them
# may ever hold a secret. There is currently no SECRET-classified variable on
# the frontend; if one is ever needed, it must be read server-side only
# (no NEXT_PUBLIC_ prefix) and never passed to a Client Component.
#
# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored — never commit real values.

# [PUBLIC] Base URL of the Medusa backend's Store API.
# Local dev default (used by src/lib/medusa.ts if unset): http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# [PUBLIC] Medusa Store API publishable key (scopes requests to a sales
# channel; safe to expose — it is not an auth credential). Find/create one in
# the Medusa Admin under Settings > Publishable API Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# [PUBLIC] Stripe's publishable key (pk_test_... / pk_live_...) — safe to
# expose by design, this is the only Stripe key that ever belongs on the
# frontend. Get it from https://dashboard.stripe.com/test/apikeys. The
# corresponding SECRET key (STRIPE_API_KEY) lives only in the Medusa
# backend's environment — see medusa-backend/apps/backend/.env.template.
# Checkout falls back to the manual/dev payment provider when this is unset.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
